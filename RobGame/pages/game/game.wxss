.container {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  min-height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

/* 背景树 */
.tree {
  position: fixed;
  font-size: 100rpx;
  opacity: 0.5;
  z-index: -1;
}

.tree-1 { top: 60rpx; left: 20rpx; font-size: 120rpx; }
.tree-2 { top: 40rpx; right: 30rpx; font-size: 100rpx; }
.tree-3 { bottom: 100rpx; left: 40rpx; font-size: 140rpx; }
.tree-4 { bottom: 80rpx; right: 20rpx; font-size: 110rpx; }
.tree-5 { top: 50%; left: -20rpx; font-size: 130rpx; opacity: 0.3; }

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 16rpx 30rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.score, .timer {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.level-info {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: bold;
}

/* 游戏面板 */
.game-board {
  display: grid;
  gap: 16rpx;
  width: 100%;
  max-width: 680rpx;
  padding: 24rpx;
  background: rgba(139, 90, 43, 0.3);
  border-radius: 24rpx;
}

/* 单个洞口 */
.hole {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto;
}

.hole-bg {
  position: absolute;
  bottom: 10rpx;
  width: 110rpx;
  height: 45rpx;
  background: radial-gradient(ellipse, #5D4037 0%, #3E2723 100%);
  border-radius: 50%;
}

/* 地鼠/炸弹 */
.mole {
  position: absolute;
  bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 90rpx;
  height: 90rpx;
  transform: translateY(70rpx);
  transition: transform 0.2s ease-out, opacity 0.2s ease-out;
  opacity: 0;
}

.mole-up {
  transform: translateY(0);
  opacity: 1;
}

.mole-hit {
  transform: translateY(0) scale(1.3);
  opacity: 1;
}

.mole-moving {
  animation: wobble 0.5s ease-in-out infinite;
}

@keyframes wobble {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(0) rotate(-5deg); }
  75% { transform: translateY(0) rotate(5deg); }
}

.mole-emoji {
  font-size: 64rpx;
}

/* 锤子 */
.hammer {
  position: absolute;
  top: -20rpx;
  right: -10rpx;
  opacity: 0;
  transform: rotate(-30deg);
  transition: transform 0.15s ease-in, opacity 0.15s ease-in;
  z-index: 10;
}

.hammer-hit {
  opacity: 1;
  transform: rotate(15deg);
}

.hammer-emoji {
  font-size: 90rpx;
}

/* 成绩细节 */
.stats {
  display: flex;
  justify-content: center;
  gap: 50rpx;
  margin-top: 24rpx;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.stat-icon {
  font-size: 40rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 结束弹窗 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 70rpx;
  background: white;
  border-radius: 30rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.result-score {
  font-size: 52rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 36rpx;
}

.btn-restart {
  width: 100%;
  padding: 16rpx 60rpx;
  background: #4CAF50;
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  margin-bottom: 16rpx;
}

.btn-back {
  width: 100%;
  padding: 16rpx 60rpx;
  background: #9E9E9E;
  color: white;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
}
