<view class="login-page">
  <view class="logo-section">
    <text class="logo-text">KidsCheck</text>
    <text class="subtitle">家庭学习打卡</text>
  </view>

  <view class="form-section" wx:if="{{showBindForm}}">
    <view class="hint">请选择你的身份</view>
    <view class="user-list">
      <view
        class="user-item {{selectedUser === item.username ? 'selected' : ''}}"
        wx:for="{{users}}"
        wx:key="username"
        bindtap="onSelectUser"
        data-user="{{item}}"
      >
        <text class="user-icon">{{item.icon}}</text>
        <text class="user-name">{{item.label}}</text>
      </view>
    </view>
    <input
      wx:if="{{selectedUser}}"
      class="input"
      type="password"
      placeholder="请输入密码"
      value="{{password}}"
      bindinput="onPasswordInput"
    />
    <button class="btn-primary" bindtap="onBind" loading="{{loading}}" disabled="{{!selectedUser || !password}}">
      确认绑定
    </button>
    <view class="error" wx:if="{{errorMsg}}">{{errorMsg}}</view>
  </view>

  <view class="loading-section" wx:else>
    <view class="loading-text">正在登录...</view>
  </view>
</view>
