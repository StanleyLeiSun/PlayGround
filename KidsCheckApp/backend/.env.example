# 数据库（默认 SQLite，本地无需额外服务）
# DATABASE_URL=sqlite+aiosqlite:///./kidscheck.db
#
# 如需使用 Postgres：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kidscheck

# JWT
JWT_SECRET=kidscheck-secret-key-change-in-production

# 文件上传
UPLOAD_DIR=uploads/photos

# 语音意图解析（可选；不填则相关接口会提示未配置）
LLM_API_KEY=
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen-plus

